# ═══════════════════════════════════════════════════════
#  VoxBabel — Environment Variables
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── App ──
DEBUG=true

# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxbabel

# ── Provider Selection (local | google) ──
STT_PROVIDER=whisper
MT_PROVIDER=opus
TTS_PROVIDER=piper

# ── Google Cloud (only if using cloud providers) ──
GOOGLE_CLOUD_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
